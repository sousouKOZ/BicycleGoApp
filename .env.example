# load_data.py / recommendation_api.py が参照するクラウド DB 接続情報。
# 値は Supabase Dashboard → Project Settings → Database → Connection string (Session pooler) から取得。
# ※ .env は .gitignore に登録済み。コミット禁止。

DATABASE_URL=postgresql://postgres.xgqsqjzkitjmtpshaslt:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Edge Function -> recommendation_api.py のサーバ間認証。
# 設定した場合、Python API 側は Authorization: Bearer <PYTHON_API_KEY> を要求する。
PYTHON_API_KEY=
PYTHON_API_URL=http://127.0.0.1:5001

# recommendation_api.py の起動設定。外部公開する場合だけ HOST を 0.0.0.0 等に変更する。
RECOMMENDATION_API_HOST=127.0.0.1
RECOMMENDATION_API_PORT=5001
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=

# parking_detect のIoT端末向けBearerトークン。
# 本番では service_role key を端末へ配らず、このトークンを使う。
DEVICE_INGEST_TOKEN=

# ローカル/撮影用の逃げ道。本番では true にしない。
ALLOW_CLIENT_DEMO_DETECT=false
ALLOW_UNAUTHENTICATED_INTERNAL_JOBS=false
